      m_Calls: []
  m_text: "<i>After station 1.</i>\nColour grading changes the finished image, not the scene. These overrides act on every pixel of the frame:\n\xB7  White Balance\n\xB7  Color Adjustments\n\xB7  Shadows, Midtones, Highlights\n\n<b>Predict:</b> Color Adjustments \u203A Saturation \u2212100 turns the frame grey. Is the life buoy's material still orange? Check: Window \u203A Analysis \u203A Rendering Debugger \u203A Material \u203A Material Filters \u203A Material Override: Albedo.\n\n<b>Try:</b> Set Material Override back to None. Grade the same frame twice: the teal of reference 26, then the orange of reference 07.\n\n<size=85%><color=#A8A8A8>Reference: 26, 07</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
