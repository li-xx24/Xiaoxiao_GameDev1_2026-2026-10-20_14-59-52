  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A wall cut around a window has many faces. Each face's Auto UVs are offset and rotated around that face's own centre, so the pattern breaks at every edge. Faces put in one Texture Group are mapped as one plane, and move and turn together.\n\n<b>Predict:</b> You select all the front faces of this wall and set Rotation to 45 in the UV Editor. Does the pattern stay continuous?\n\n<b>Try:</b>\n1. In the UV Editor, select the front faces and set Rotation to 45.\n2. Click Group Selected Faces.\n3. Change Rotation and Offset again and compare.\n\n<size=85%><color=#A8A8A8>Reference: Editing-Faces 2 \xB7 Openings</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
