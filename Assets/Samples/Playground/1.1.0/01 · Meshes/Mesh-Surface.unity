  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "ProBuilder computes each face's UVs automatically (Auto UVs). By default it projects them from the object's own space, so the texture moves with the object. With World Space on, it projects from the world position instead: separate pieces placed side by side continue one pattern.\n\n<b>Predict:</b> The two wall pieces are separate objects, side by side. You turn on World Space for both. Do the bricks line up at the joint?\n\n<b>Try:</b>\n1. Open Tools \u203A ProBuilder \u203A Editors \u203A Open UV Editor.\n2. In Face mode, select all the faces of both pieces.\n3. Under Special, tick World Space, then move one piece.\n\n<size=85%><color=#A8A8A8>Reference: Textures topic, Texture-Placement (texel density)</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
