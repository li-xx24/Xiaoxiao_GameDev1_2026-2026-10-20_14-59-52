  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The Boolean tool combines two ProBuilder meshes into a new one. Union joins them, Subtraction cuts one out of the other, Intersection keeps only the part they share. It is an experimental ProBuilder feature: it must be switched on first, and its results can have untidy faces.\n\n<b>Predict:</b> You subtract the cylinder from the wall with the Boolean tool. How many objects will the Hierarchy show afterwards?\n\n<b>Try:</b>\n1. In Edit \u203A Preferences \u203A ProBuilder, tick Experimental Features Enabled; Unity recompiles.\n2. Select the wall and the cylinder, then open Tools \u203A ProBuilder \u203A Experimental \u203A Boolean (CSG) Tool.\n3. Set Operation to Subtraction, check the title reads \"Wall Subtracts Cylinder\" (the arrows swap the order), and click Apply.\n\n<size=85%><color=#A8A8A8>Reference: Liminal-Kit 1 \xB7 Walls and openings (Arch)</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
