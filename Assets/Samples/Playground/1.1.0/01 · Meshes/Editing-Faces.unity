  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A ProBuilder shape has only the faces it was built with. Where a face is missing the surface has a hole: you see into the hollow, and the faces behind it are hidden from that side.\n\n<b>Predict:</b> This gate is ProBuilder's Door shape, unchanged. Which of its faces are missing?\n\n<b>Try:</b>\n1. Orbit around the gate in the Scene view.\n2. In Edge mode, select an open edge on the front and the matching edge on the back, and use Bridge Edges.\n3. Close the sides and the top this way.\n\n<size=85%><color=#A8A8A8>Reference: Liminal-Kit 1 \xB7 Walls and openings (Concrete gate)</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
