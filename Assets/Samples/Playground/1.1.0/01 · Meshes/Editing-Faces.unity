  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A face can only be removed whole, so an opening first needs its own face. Insert Edge Loop cuts a ring of new edges around the object; Connect Edges cuts only between the edges you select.\n\n<b>Predict:</b> You select the top edge of the wall's front and use Insert Edge Loop. Where do the new edges appear?\n\n<b>Try:</b>\n1. Try it and orbit around the wall. Undo.\n2. Cut the front with two vertical and two horizontal edge loops, so there is a face where a window should be.\n3. Station 2 continues from there.\n\n<size=85%><color=#A8A8A8>Reference: Liminal-Kit 1 \xB7 Walls and openings (Slit wall)</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
