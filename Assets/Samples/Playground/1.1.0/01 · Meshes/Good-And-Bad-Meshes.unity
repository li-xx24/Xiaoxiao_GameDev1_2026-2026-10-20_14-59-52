  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Each face has a front, set by its normal. When the normals point inward, the mesh is drawn inside out: from outside you see through the near faces to the inner side of the far ones, and the light falls on the wrong side.\n\n<b>Predict:</b> This wall's normals point inward. From outside, which of its faces will you see: the near ones or the far ones?\n\n<b>Try:</b>\n1. Orbit around the wall and look at it from each side.\n2. Pro Builderize it, then use Flip Normals.\n3. To fix the file itself: in Blender, recalculate the normals outside, then export again.\n\n<size=85%><color=#A8A8A8>Reference: Mesh-Shape 4 \xB7 A mesh is hollow</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
