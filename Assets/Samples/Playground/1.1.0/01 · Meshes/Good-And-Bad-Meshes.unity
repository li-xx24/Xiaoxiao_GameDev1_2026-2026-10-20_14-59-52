  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "The pivot is where the Transform's position sits. A kit piece is easy to place when its pivot is on a corner or the base centre, and its size is in whole grid steps. A pivot floating off the piece makes it snap to the wrong places.\n\n<b>Predict:</b> You snap this wall piece to the grid. Where will its corner land?\n\n<b>Try:</b>\n1. Turn on grid snapping and move the wall: watch its corner.\n2. Pro Builderize it.\n3. In Vertex mode, select its bottom corner, use Set Pivot To Selection, and snap again.\n\n<size=85%><color=#A8A8A8>Reference: Mesh-Shape 5 \xB7 The pivot</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
  m_sharedMaterial: {fileID: -6055507529455485361, guid: 2f7116f10747a67409388e93052ae222, type: 2}
