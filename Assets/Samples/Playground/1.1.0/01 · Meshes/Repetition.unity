  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "A spline is a curve defined by a few points, its knots. The Spline Instantiate component places copies of a prefab along a spline. With Linear Distance it places one copy every few metres, so a longer spline gets more copies.\n\n<b>Predict:</b> The columns stand every 4 m. You drag the last knot 8 m further. How many columns are added?\n\n<b>Try:</b>\n1. Select Colonnade, switch the Tools overlay to the Spline context, and drag the last knot 8 m further.\n2. In Spline Instantiate, change the spacing from 4 to 3.\n3. Set Instantiate Method to Instance Count and drag the knot again.\n\n<size=85%><color=#A8A8A8>Reference: Liminal-Kit 3 \xB7 Columns and furniture (Round pillar)</color></size>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2f7116f10747a67409388e93052ae222, type: 2}
